# Local Compose defaults. Replace secrets before use; production Compose enforces secure cookies and Redis.
POSTGRES_DB=securityops
# Use three independent, randomly generated secrets; the administrator secret is not passed to API or worker.
POSTGRES_ADMIN_USER=securityops_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-admin-secret
POSTGRES_MIGRATION_PASSWORD=replace-with-a-unique-migration-secret
POSTGRES_RUNTIME_PASSWORD=replace-with-a-unique-runtime-secret
# Generate a Fernet key before enabling MFA; keep the same key on every API instance.
MFA_ENCRYPTION_KEY=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Use the deployed HTTPS origin when browsers access a different origin.
CORS_ORIGINS=http://localhost:5173
# Ensure this subnet does not overlap another Docker or host network.
APP_NETWORK_SUBNET=172.28.0.0/24
APP_FRONTEND_IP=172.28.0.10
# Comma-separated addresses of trusted proxies; never use "*".
FORWARDED_ALLOW_IPS=172.28.0.10
# Private, not web-served document storage. Set to a persistent directory outside public static files.
DOCUMENT_STORAGE_PATH=/var/lib/securityops/documents
# Upload limit (20 MiB by default; maximum supported setting is 100 MiB).
DOCUMENT_MAX_UPLOAD_BYTES=20971520
# ClamAV-Scanlimit (maximal 100 MiB) und Zeitlimit für jeden Upload.
MALWARE_SCANNER_HOST=clamav
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_SECONDS=30
MALWARE_SCAN_MAX_BYTES=104857600
# Worker für persistierte In-App-Benachrichtigungen.
NOTIFICATION_WORKER_POLL_SECONDS=2
NOTIFICATION_WORKER_BATCH_SIZE=25
NOTIFICATION_WORKER_LEASE_SECONDS=300
NOTIFICATION_WORKER_MAX_ATTEMPTS=8
