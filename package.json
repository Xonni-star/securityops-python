{
  "name": "securityops",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo-Einstieg: Frontend liegt als Workspace in frontend/.",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "test": "npm --workspace frontend test",
    "preview": "npm --workspace frontend run preview"
  }
}
